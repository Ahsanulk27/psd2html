# Copy to .env and fill in.
# Your Claude API key (the name CLAUDE_API_KEY also works)
ANTHROPIC_API_KEY=

# Shared secret Palette's server sends in the X-Psd2html-Key header.
# Leave empty on a developer machine to keep the API open; required when
# PSD2HTML_ENV=production.
PSD2HTML_SHARED_SECRET=
PSD2HTML_ENV=development

# Optional settings (defaults shown)
# PSD2HTML_MODEL=claude-opus-5-5
# PSD2HTML_EFFORT=high            # low | medium | high | xhigh | max (HTML mode)
# PSD2HTML_PHOTOCARD_MODEL=       # photocard mode; empty means PSD2HTML_MODEL
# PSD2HTML_PHOTOCARD_EFFORT=medium
# PSD2HTML_DATA=data              # where jobs are stored
# PSD2HTML_MAX_UPLOAD_MB=500
# PSD2HTML_WORKERS=2              # conversions that run at the same time
# PSD2HTML_JOB_TTL_HOURS=24       # finished jobs are deleted after this
